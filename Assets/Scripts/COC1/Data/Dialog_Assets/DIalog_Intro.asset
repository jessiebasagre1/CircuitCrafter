  m_Script: {fileID: 11500000, guid: 0d5562cc34807e2439c5cc188b7351d9, type: 3}
  m_Name: DIalog_Intro
  m_EditorClassIdentifier: Assembly-CSharp::DialogSequence
  lines:
  - speakerName: Guide
    text: Welcome to CircuitCrafter! In this simulation, you'll learn how to safely
      disassemble and assemble a desktop computer. Follow each instruction carefully
      and complete every step in the correct order. Remember, handling computer components
      incorrectly can damage the hardware.
  - speakerName: Guide
    text: Walk to the desktop computer and interact with it to begin the PC disassembly
      and assembly simulation. Follow the on-screen instructions carefully to complete
      each task.
