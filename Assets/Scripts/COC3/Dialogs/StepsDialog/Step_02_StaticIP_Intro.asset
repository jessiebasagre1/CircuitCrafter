  m_Script: {fileID: 11500000, guid: 0d5562cc34807e2439c5cc188b7351d9, type: 3}
  m_Name: Step_02_StaticIP_Intro
  m_EditorClassIdentifier: Assembly-CSharp::DialogSequence
  lines:
  - speakerName: Instructor
    text: "\"A server has to be findable. If this machine took its address from DHCP,
      that address could change after a reboot \u2014 and every client looking for
      the domain would be looking at the wrong place. Servers get a static address,
      set by hand. Clients can keep using DHCP.\""
