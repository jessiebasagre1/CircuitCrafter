  m_Script: {fileID: 11500000, guid: 0d5562cc34807e2439c5cc188b7351d9, type: 3}
  m_Name: Hint_Step15_AccessPolicies
  m_EditorClassIdentifier: Assembly-CSharp::DialogSequence
  lines:
  - speakerName: Hint
    text: Start > Group Policy Management.
  - speakerName: Hint
    text: "Computer Configuration > Policies > Windows Settings > Security Settings
      > Account Policies, then select Password Policy in the tree \u2014 Account
      Lockout Policy is a different control."
  - speakerName: Hint
    text: Open Minimum password length. Ticking "Define this policy setting" is what
      turns it on; the number alone does nothing.
