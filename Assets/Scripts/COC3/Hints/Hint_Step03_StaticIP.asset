  m_Script: {fileID: 11500000, guid: 0d5562cc34807e2439c5cc188b7351d9, type: 3}
  m_Name: Hint_Step03_StaticIP
  m_EditorClassIdentifier: Assembly-CSharp::DialogSequence
  lines:
  - speakerName: Hint
    text: Network Connections is on the Start menu, and on the desktop.
  - speakerName: Hint
    text: "Click Ethernet, then Properties. In the list, select Internet Protocol
      Version 4 (TCP/IPv4) \u2014 selecting it is what enables the Properties button
      beneath it."
  - speakerName: Hint
    text: "Choose Use the following IP address and Use the following DNS server addresses.
      IP 192.168.10.10, subnet mask 255.255.255.0, default gateway 192.168.10.1,
      preferred DNS 127.0.0.1. Then OK \u2014 Windows applies the whole sheet at
      once."
