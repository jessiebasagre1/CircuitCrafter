  m_Script: {fileID: 11500000, guid: 0d5562cc34807e2439c5cc188b7351d9, type: 3}
  m_Name: ClientSucessDialog
  m_EditorClassIdentifier: Assembly-CSharp::DialogSequence
  lines:
  - speakerName: Guide
    text: "Client workstation configured. 192.168.1.20, mask 255.255.255.0, gateway
      192.168.1.1 \u2014 that matches the job order."
  - speakerName: Guide
    text: Same mask, same gateway, different host address. The mask is what says
      both machines belong to 192.168.1; the last number is what keeps them apart.
