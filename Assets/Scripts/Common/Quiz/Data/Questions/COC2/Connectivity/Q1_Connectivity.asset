  m_Script: {fileID: 11500000, guid: 3e4b5683c1ea36345958694d590b6436, type: 3}
  m_Name: Q1_Connectivity
  m_EditorClassIdentifier: Assembly-CSharp::QuizQuestionData
  questionText: Which command tests whether one host can reach another?
  choices:
  - ipconfig
  - ping
  - netstat
  - hostname
  correctChoiceIndex: 1
  points: 10
  explanation: ping sends ICMP echo requests and reports the replies. ipconfig shows
    this machine's own settings but says nothing about whether anything else is reachable.
