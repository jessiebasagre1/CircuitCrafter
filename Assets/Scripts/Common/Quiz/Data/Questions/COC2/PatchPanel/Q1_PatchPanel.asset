  m_Script: {fileID: 11500000, guid: 3e4b5683c1ea36345958694d590b6436, type: 3}
  m_Name: Q1_PatchPanel
  m_EditorClassIdentifier: Assembly-CSharp::QuizQuestionData
  questionText: Which tool terminates a conductor into the IDC block of a patch panel?
  choices:
  - Crimping tool
  - Punch-down tool
  - Wire stripper
  - Cable tester
  correctChoiceIndex: 1
  points: 10
  explanation: 'The punch-down tool (the 110 tool) seats the conductor into the insulation-displacement
    contact. A crimping tool works on RJ45 plugs, which is the other end of the same
    cable.

    

'
