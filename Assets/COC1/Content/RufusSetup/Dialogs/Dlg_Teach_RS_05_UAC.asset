  m_Script: {fileID: 11500000, guid: 0d5562cc34807e2439c5cc188b7351d9, type: 3}
  m_Name: Dlg_Teach_RS_05_UAC
  m_EditorClassIdentifier: Assembly-CSharp::DialogSequence
  lines:
  - speakerName: Guide
    text: User Account Control is Windows asking permission before a program is allowed
      to change the system. Rufus needs it because writing to a raw disk is exactly
      the kind of thing UAC exists to gate. The line that matters is the publisher
      - an unsigned or unexpected publisher on a UAC prompt is a reason to stop.
