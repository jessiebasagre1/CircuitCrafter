  m_Script: {fileID: 11500000, guid: 0d5562cc34807e2439c5cc188b7351d9, type: 3}
  m_Name: Dlg_Teach_OS_16_AccountSetup
  m_EditorClassIdentifier: Assembly-CSharp::DialogSequence
  lines:
  - speakerName: Guide
    text: 'A local administrator account is the standard shop build: it works with
      no internet, it is what you use to join the domain in COC 3, and it does not
      tie the customer''s machine to your Microsoft account. Set a password - an
      account with no password fails the security check at handover.'
