  m_Script: {fileID: 11500000, guid: 0d5562cc34807e2439c5cc188b7351d9, type: 3}
  m_Name: Dlg_Teach_OS_10_PartitionSelect
  m_EditorClassIdentifier: Assembly-CSharp::DialogSequence
  lines:
  - speakerName: Guide
    text: You cannot install onto raw unallocated space, and you cannot install onto
      a partition that has never been formatted. New creates the partition, Format
      lays down the NTFS file system. Windows quietly adds its own System, MSR and
      Recovery partitions alongside yours - leave those alone.
