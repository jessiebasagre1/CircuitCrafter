  m_Script: {fileID: 11500000, guid: 0d5562cc34807e2439c5cc188b7351d9, type: 3}
  m_Name: Dlg_Teach_OS_15_RegionKeyboard
  m_EditorClassIdentifier: Assembly-CSharp::DialogSequence
  lines:
  - speakerName: Guide
    text: Region and keyboard are two separate questions. The Philippines uses a
      US physical keyboard, so the right answer is a Philippine region with a US
      layout - picking a Dvorak or UK layout leaves the customer with keys that type
      the wrong characters.
