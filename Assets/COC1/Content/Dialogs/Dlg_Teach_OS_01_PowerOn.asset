  m_Name: Dlg_Teach_OS_01_PowerOn
  m_EditorClassIdentifier: Assembly-CSharp::DialogSequence
  lines:
  - speakerName: Guide
    text: 'Before switching on: case closed, power cable seated, no tools left inside,
      hands dry. A unit that is powered on with the side panel off and a screwdriver
      on the board is an OHS finding, not just an untidy bench.'
