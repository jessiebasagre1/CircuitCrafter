  m_EditorClassIdentifier: Assembly-CSharp::CircuitCrafter.Guidance.JobOrderData
  jobNumber: JO-COC3-001
  moduleId: COC3
  unitTitle: Set up computer servers
  customerName: Principal Dela Cruz
  customerDetail: School computer laboratory
  request: Set up our new server so teachers and students can sign in with their
    own accounts and share files.
  problem: The server is freshly installed with no network settings, roles, accounts
    or shares.
  expectedOutcomes:
  - Server named and given its static IP address
  - Server roles installed and the domain created
  - User accounts, groups and shared folders created with the correct permissions
  - Connectivity tested from a client, and the work documented
  specifications:
  - 'Server addressing and names: as set by your trainer (edit this job order)'
  whatYouWillPractise: Configuring a Windows server from addressing through roles,
    accounts, shares and permissions.
  toolsNeeded: []
  safetyReminder: Record every setting you change - a server's configuration must
    be reproducible.
  assessmentTitle: COC 3 Assessment - Set Up Computer Servers
  assessmentScenario: A new server must be configured to provide accounts and shared
    resources to the school network.
  assessmentOutcomes:
  - Configure the server to the specifications below.
  - Provide the required accounts, groups and shared resources.
  - Test the services and document the work.
  timeLimitMinutes: 0
