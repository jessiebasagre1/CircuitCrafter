    outcomeCode: LO4
    areaToImprove: Installing application software
    activityId: coc1-system-config
  - moduleId: COC1
    outcomeCode: LO5
    areaToImprove: Testing and documenting the work
    activityId: coc1-system-config
  - moduleId: COC2
    outcomeCode: LO1
    areaToImprove: Preparing and terminating cables
    activityId: coc2-crimping
  - moduleId: COC2
    outcomeCode: LO2
    areaToImprove: Testing cable terminations
    activityId: coc2-crimping
  - moduleId: COC2
    outcomeCode: LO3
    areaToImprove: Structured cabling
    activityId: coc2-punchdown
  - moduleId: COC3
