  m_Script: {fileID: 11500000, guid: ab975d03e41288b4b9cc6c3ab66dd52c, type: 3}
  m_Name: Competency_COC2
  m_EditorClassIdentifier: Assembly-CSharp::CircuitCrafter.Assessment.CompetencyDefinition
  moduleId: COC2
  unitCode: 
  unitTitle: Set up computer networks
  outcomes:
  - code: LO1
    title: Prepare and terminate network cables
    criteria: Strips, arranges and crimps UTP cable to the correct standard for both
      straight-through and crossover.
    evidenceTaskIds:
    - crimp_cable
    requiredEvidenceCount: 0
  - code: LO2
    title: Test cable terminations
    criteria: Verifies continuity and pin order with a cable tester and interprets
      the result.
    evidenceTaskIds:
    - test_cable
    requiredEvidenceCount: 0
  - code: LO3
    title: Terminate structured cabling
    criteria: Punches down conductors to a patch panel in the correct order and verifies
      the port.
    evidenceTaskIds:
    - punch_patch_panel
    requiredEvidenceCount: 0
