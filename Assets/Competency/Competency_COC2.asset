MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ab975d03e41288b4b9cc6c3ab66dd52c, type: 3}
  m_Name: Competency_COC2
  m_EditorClassIdentifier: Assembly-CSharp::CircuitCrafter.Assessment.CompetencyDefinition
  moduleId: COC2
  unitCode: 
  unitTitle: Set-up computer networks
  outcomes:
  - code: LO1
    title: Install network cables
    criteria: Cables are crimped to T568A/B, tested for continuity and correct pinout,
      and terminated to the patch panel and switch.
    evidenceTaskIds:
    - crimp_cable
    - test_cable
    - punch_patch_panel
    - patch_to_switch
    requiredEvidenceCount: 0
  - code: LO2
    title: Set network configuration
    criteria: IP address, subnet mask and gateway are assigned to the server and
      client per the job order.
    evidenceTaskIds:
    - configure_network
    requiredEvidenceCount: 0
  - code: LO3
    title: Inspect and test the configured computer networks
    criteria: Connectivity is verified in both directions by ping between the client
      and the server.
    evidenceTaskIds:
    - verify_connectivity
    requiredEvidenceCount: 0
