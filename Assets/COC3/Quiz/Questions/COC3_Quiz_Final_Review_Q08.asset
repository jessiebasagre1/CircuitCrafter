  m_Script: {fileID: 11500000, guid: 3e4b5683c1ea36345958694d590b6436, type: 3}
  m_Name: COC3_Quiz_Final_Review_Q08
  m_EditorClassIdentifier: Assembly-CSharp::QuizQuestionData
  questionText: Which of these is the best evidence that the whole print chain works?
  choices:
  - The printer appears in Devices and Printers on the client
  - The printer's status shows Ready on the server
  - A test page printed from the client comes out
  - The share name is correct
  correctChoiceIndex: 2
  points: 10
  explanation: A page on the tray proves sharing, name resolution, driver installation
    and the Print permission all at once. Any one of them broken and nothing comes
    out.
