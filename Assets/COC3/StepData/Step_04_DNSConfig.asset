  expectedSubnetMask: 
  expectedGateway: 
  textFieldLabel: Preferred DNS Server
  textFieldExpectedValue: 127.0.0.1
  textFieldCaseSensitive: 0
  pointsForCorrect: 5
  pointsPenaltyForMistake: 3
