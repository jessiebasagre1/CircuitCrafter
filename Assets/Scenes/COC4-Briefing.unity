  m_Script: {fileID: 11500000, guid: f06c872a6ae70af488a9d06f67b43369, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AssessmentIntroPanel
  modeId: COC4
  panel: {fileID: 211866319}
  titleText: {fileID: 211866318}
  objectivesText: {fileID: 211866317}
  rulesText: {fileID: 211866316}
  startButton: {fileID: 211866315}
  title: "COC 4 \u2013 Maintain and Repair Computer Systems and Networks"
  objectives:
  - You will be given 5 repair tickets chosen at random, one computer at a time.
  - Confirm each reported problem by switching the computer on and observing the
    symptom.
  - Examine the system and identify the cause before touching any hardware.
  - Record your diagnosis, then perform the corrective action.
  - Test the computer to verify the repair before the ticket is closed.
  rules: 'You have 40 minutes for all 5 tickets together. The clock starts when you
    press Start and does not stop between tickets.

    A ticket diagnosed AND repaired
    earns 100 points; a correct diagnosis without a finished repair earns 40.

    Each
    recorded mistake (for example, a wrong diagnosis) costs 10 points.

    If you
    are stuck, Give Up moves you to the next ticket. It cannot be undone.

    No
    hints or tutorials are shown during the assessment.


    If you change the ticket
    count, time limit or points on the launcher, update these numbers to match.'
  bullet: "\u2022  "
  beginOnStart: []
  hideUntilStart: []
  freezeUntilStart: []
  manageCursor: 1
  holdPlayer: 1
  keepOnTop: 1
  enterStarts: 1
  reportMissedClicks: 1
  disableForAssessment: []
  suppressDialogsDuringBriefing: 0
  OnBriefingShown:
    m_PersistentCalls:
      m_Calls: []
  OnStarted:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1776286676}
        m_TargetAssemblyTypeName: CircuitCrafter.Repair.COC4AssessmentLauncher, Assembly-CSharp
        m_MethodName: StartAssessment
