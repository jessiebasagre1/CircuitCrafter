  m_EditorClassIdentifier: Assembly-CSharp::AssessmentIntroPanel
  modeId: COC2
  panel: {fileID: 669863260}
  titleText: {fileID: 656472233}
  objectivesText: {fileID: 1344857554}
  rulesText: {fileID: 338418650}
  startButton: {fileID: 1151542199}
  title: COC 2 - Cable Assembly and Testing
  objectives:
  - Collect the crimping tool from the workbench.
  - Strip the jacket without nicking the conductors.
  - Arrange all eight wires to the standard for the cable you were asked to build.
  - Crimp both ends. A crimped RJ45 cannot be reopened - get it right first time.
  - Test the cable. It must pass all eight conductors.
  - Build and pass BOTH a straight-through and a crossover cable.
  rules: 'You are timed from the moment you press Start.

    Every cable that fails
    the tester is recorded, with the fault that caused it.

    A run finished with
    no failures earns a bonus.'
  bullet: "\u2022  "
  beginOnStart:
  - {fileID: 988095436}
  hideUntilStart:
