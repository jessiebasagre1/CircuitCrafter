%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 95ffa952c0679944092eb9effd5dba6a, type: 3}
  m_Name: Ticket_Coc1_Ssd_Missing_Observations
  m_EditorClassIdentifier: Assembly-CSharp::CircuitCrafter.Repair.TicketObservationSet
  ticketId: ticket_coc1_ssd_missing
  observations:
  - observationId: power_on
    action: Press the power button and listen
    result: Fans spin. One short beep - the normal sound for a system that has passed
      POST.
    timeCostSeconds: 10
  - observationId: check_screen
    action: Look at the monitor
    result: 'The board''s logo appears normally, then: "No boot device found. Press
      any key to reboot."'
    timeCostSeconds: 10
  - observationId: check_setup
    action: Enter setup and look at the drive list
    result: The storage list is empty. No drive is detected on any port.
    timeCostSeconds: 25
  - observationId: open_case
    action: Open the case and inspect
    result: Everything is tidy and dust-free. The drive bay is empty - no storage
      drive is fitted.
    timeCostSeconds: 30
