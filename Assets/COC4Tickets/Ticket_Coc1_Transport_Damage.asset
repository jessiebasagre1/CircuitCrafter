%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 146b4dedcb9af3b4ab5fe5794271c3d8, type: 3}
  m_Name: Ticket_Coc1_Transport_Damage
  m_EditorClassIdentifier: Assembly-CSharp::TicketData
  ticketId: ticket_coc1_transport_damage
  targetModule: 0
  sceneName: COC1-Copy
  title: Unit arrived from another branch and won't start
  description: This machine was shipped between offices. It was working when it was
    packed. Now it powers on but shows nothing on screen.
  icon: {fileID: 0}
  briefingDialog: {fileID: 0}
  requiredTaskId: ticket_coc1_transport_damage
  requiresDiagnosis: 1
  symptomText: 'System powers on, fans normal. No display. POST beep code: 1 long,
    3 short. Case screws were found loose.'
  diagnosisOptions:
  - label: More than one component has worked loose in transit
    isCorrect: 1
    feedback: Correct. The beep code points at memory, but loose case screws and
      a shipped unit mean you should check every seated component before closing
      the job - fixing only the first fault you find leaves the customer with a machine
      that still does not work.
  - label: Memory not seated
    isCorrect: 0
    feedback: The beep code does say memory, and that is part of it - but reseating
      only the RAM leaves this machine still faulty. Look wider on a unit that has
      been shipped.
  - label: Failed motherboard
    isCorrect: 0
    feedback: A dead board would not produce a valid beep code. The board is running
      well enough to tell you what is wrong.
  - label: Power supply failure
    isCorrect: 0
    feedback: Fans and POST beeps both need power, and both are happening.
