--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 95ffa952c0679944092eb9effd5dba6a, type: 3}
  m_Name: Ticket_Coc3_No_Dhcp_Observations
  m_EditorClassIdentifier: Assembly-CSharp::CircuitCrafter.Repair.TicketObservationSet
  ticketId: ticket_coc3_no_dhcp
  observations:
  - observationId: check_link
    action: Check the network cable and link light
    result: Cable seated, link light on and flickering.
    timeCostSeconds: 10
  - observationId: run_ipconfig
    action: Run ipconfig on the workstation
    result: IPv4 Address 169.254.14.62, Subnet Mask 255.255.0.0, and no default gateway
      listed.
    timeCostSeconds: 15
  - observationId: check_adapter
    action: Open the adapter's IPv4 properties
    result: Set to "Obtain an IP address automatically". Nothing has been entered
      by hand.
    timeCostSeconds: 15
  - observationId: ping_server
    action: Ping the server
    result: 'PING: transmit failed. General failure.'
    timeCostSeconds: 15
