  m_Script: {fileID: 11500000, guid: 0d5562cc34807e2439c5cc188b7351d9, type: 3}
  m_Name: Hint_Step_15_AccessPolicies
  m_EditorClassIdentifier: Assembly-CSharp::DialogSequence
  lines:
  - speakerName: Hint
    text: "<b>Start \u25B8 Group Policy Management</b>.\n\nComputer Configuration
      > Policies > Windows Settings > Security Settings > Account Policies, then
      select <b>Password Policy</b> in the tree.\n\nOpen <b>Minimum password length</b>.\nTick
      <b>Define this policy setting</b>, then enter <b>8</b>.\n\nThe tick box is
      what turns the policy on - the number alone does nothing."
