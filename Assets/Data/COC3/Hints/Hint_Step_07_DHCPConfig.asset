  m_Script: {fileID: 11500000, guid: 0d5562cc34807e2439c5cc188b7351d9, type: 3}
  m_Name: Hint_Step_07_DHCPConfig
  m_EditorClassIdentifier: Assembly-CSharp::DialogSequence
  lines:
  - speakerName: Hint
    text: "<b>Start \u25B8 DHCP</b>, then click <b>IPv4</b> in the tree.\n\nStart
      IP address:  <b>192.168.10.100</b>\nSubnet mask:  <b>255.255.255.0</b>\nRouter
      (default gateway):  <b>192.168.10.1</b>\n\nThe pool starts at .100 because
      SERVER01 holds .10 - a scope that began lower would eventually hand a client
      the server's own address."
