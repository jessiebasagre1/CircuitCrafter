  m_Script: {fileID: 11500000, guid: 0d5562cc34807e2439c5cc188b7351d9, type: 3}
  m_Name: Hint_Step_05_InstallRoles
  m_EditorClassIdentifier: Assembly-CSharp::DialogSequence
  lines:
  - speakerName: Hint
    text: "<b>Server Manager</b> is on the desktop and on the Start menu.\n\n<b>Manage
      \u25BE</b>, or the tile \"2  Add roles and features\". On the Server Roles
      page tick <b>all five</b>:\n\nActive Directory Domain Services\nDHCP Server\nDNS
      Server\nFile and Storage Services\nPrint and Document Services\n\nThen <b>Install</b>."
